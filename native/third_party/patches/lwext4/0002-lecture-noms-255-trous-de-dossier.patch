+/**@brief Physical block of an existing directory block, for dx_init.
+ *        ext4_fs_init_inode_dblk_idx allocates a missing block only for
+ *        extent-mapped inodes: with indirect mapping it gives 0, which must
+ *        never be used (block 0 of the device: boot area and superblock).
+ * @return EFSCORRUPTED for a hole inside the directory, ENOTSUP for a block
+ *         beyond its end that would have to be allocated */
+static int ext4_dir_dx_init_dblk(struct ext4_inode_ref *dir,
+				 ext4_lblk_t iblock, ext4_fsblk_t *fblock)
+{
+	int rc = ext4_fs_init_inode_dblk_idx(dir, iblock, fblock);
+	if (rc != EOK)
+		return rc;
+
+	if (*fblock == 0) {
+		uint64_t size = ext4_inode_get_size(&dir->fs->sb, dir->inode);
+		uint32_t block_size = ext4_sb_get_block_size(&dir->fs->sb);
+		return (uint64_t)iblock * block_size < size ? EFSCORRUPTED
+							    : ENOTSUP;
+	}
+
+	return EOK;
+}
