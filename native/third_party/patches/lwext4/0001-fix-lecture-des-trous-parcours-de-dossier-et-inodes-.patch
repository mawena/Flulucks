From 938671970bd1797c229328bb6a8d4b2b999ba413 Mon Sep 17 00:00:00 2001
From: mawena <gamligocharles@gmail.com>
Date: Sat, 17 Oct 2026 14:58:28 +0000
Subject: [PATCH] fix: lecture des trous, parcours de dossier et inodes
 robustes (FluLuks)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- ext4_fread : un trou ou un extent non écrit (bloc physique 0) dans les
  blocs entiers ou le bloc final partiel est rendu comme des zéros au lieu
  du contenu du bloc 0 ; suites de blocs bornées à 4096.
- ext4_dir_entry_get : nouvelle fonction qui rend un code d'erreur ; plus
  de déréférencement NULL sur un dossier vide ou corrompu, longueur de nom
  bornée à 255 ; ext4_dir_entry_next devient une enveloppe.
- ext4_raw_inode_fill_ino : lecture d'un inode par numéro, numéro vérifié
  contre inodes_count.
- ext4_raw_inode_fill : copie bornée à la taille d'inode du disque (pas de
  débordement avec des inodes de 128 octets).
---
 include/ext4.h |  19 ++++++
 src/ext4.c     | 180 ++++++++++++++++++++++++++++++++++++-------------
 2 files changed, 152 insertions(+), 47 deletions(-)

diff --git a/include/ext4.h b/include/ext4.h
index 18e756e..972a87f 100644
--- a/include/ext4.h
+++ b/include/ext4.h
@@ -395,6 +395,17 @@ uint64_t ext4_fsize(ext4_file *file);
 int ext4_raw_inode_fill(const char *path, uint32_t *ret_ino,
 			struct ext4_inode *inode);
 
+/**@brief Get inode by number.
+ *
+ * @param mount_point Mount point.
+ * @param ino         Inode number (checked against the superblock).
+ * @param inode       Inode internals (bytes beyond the on-disk inode size
+ *                    are zeroed).
+ *
+ * @return  Standard error code (EIO for an out-of-range number).*/
+int ext4_raw_inode_fill_ino(const char *mount_point, uint32_t ino,
+			    struct ext4_inode *inode);
+
 /**@brief Check if inode exists.
  *
  * @param path    Parh to file/dir/link.
@@ -611,6 +622,14 @@ int ext4_dir_close(ext4_dir *dir);
  * @return  Directory entry id (NULL if no entry)*/
 const ext4_direntry *ext4_dir_entry_next(ext4_dir *dir);
 
+/**@brief   Return next directory entry, reporting errors.
+ *
+ * @param   dir Directory handle.
+ * @param   out Directory entry, NULL at the end of the directory or on error.
+ *
+ * @return  Standard error code (EIO for a corrupted directory).*/
+int ext4_dir_entry_get(ext4_dir *dir, const ext4_direntry **out);
+
 /**@brief   Rewine directory entry offset.
  *
  * @param   dir Directory handle.*/
diff --git a/src/ext4.c b/src/ext4.c
index 90ce45e..32d199a 100644
--- a/src/ext4.c
+++ b/src/ext4.c
@@ -1669,11 +1669,15 @@ int ext4_ftruncate(ext4_file *f, uint64_t size)
 	return r;
 }
 
+/**@brief   Maximum number of blocks read by one ext4_blocks_get_direct()
+ *          call in ext4_fread() (64 KiB blocks of 512-byte sectors still
+ *          fit a 32-bit sector count).*/
+#define EXT4_FREAD_MAX_RUN 4096
+
 int ext4_fread(ext4_file *file, void *buf, size_t size, size_t *rcnt)
 {
 	uint32_t unalg;
 	uint32_t iblock_idx;
-	uint32_t iblock_last;
 	uint32_t block_size;
 
 	ext4_fsblk_t fblock;
@@ -1714,7 +1718,6 @@ int ext4_fread(ext4_file *file, void *buf, size_t size, size_t *rcnt)
 		? ((size_t)(file->fsize - file->fpos)) : size;
 
 	iblock_idx = (uint32_t)((file->fpos) / block_size);
-	iblock_last = (uint32_t)((file->fpos + size) / block_size);
 	unalg = (file->fpos) % block_size;
 
 	/*If the size of symlink is smaller than 60 bytes*/
@@ -1769,52 +1772,73 @@ int ext4_fread(ext4_file *file, void *buf, size_t size, size_t *rcnt)
 		iblock_idx++;
 	}
 
-	fblock_start = 0;
-	fblock_count = 0;
+	/*
+	 * Whole blocks. A hole or an unwritten extent maps to fblock 0 and
+	 * must read as zeros, never as the content of block 0.
+	 */
 	while (size >= block_size) {
-		while (iblock_idx < iblock_last) {
+		size_t max_cnt = size / block_size;
+		size_t run_bytes;
+
+		/* Keep pb_cnt * cnt in ext4_blocks_get_direct within 32 bits. */
+		if (max_cnt > EXT4_FREAD_MAX_RUN)
+			max_cnt = EXT4_FREAD_MAX_RUN;
+
+		r = ext4_fs_get_inode_dblk_idx(&ref, iblock_idx, &fblock, true);
+		if (r != EOK)
+			goto Finish;
+
+		fblock_start = fblock;
+		fblock_count = 1;
+		iblock_idx++;
+
+		/* Extend the run: contiguous blocks, or consecutive holes. */
+		while (fblock_count < max_cnt) {
 			r = ext4_fs_get_inode_dblk_idx(&ref, iblock_idx,
 						       &fblock, true);
 			if (r != EOK)
 				goto Finish;
 
-			iblock_idx++;
-
-			if (!fblock_start)
-				fblock_start = fblock;
-
-			if ((fblock_start + fblock_count) != fblock)
+			if (fblock_start == 0 ? fblock != 0
+			    : fblock != fblock_start + fblock_count)
 				break;
 
 			fblock_count++;
+			iblock_idx++;
 		}
 
-		r = ext4_blocks_get_direct(file->mp->fs.bdev, u8_buf, fblock_start,
-					   fblock_count);
-		if (r != EOK)
-			goto Finish;
+		run_bytes = (size_t)block_size * fblock_count;
+		if (fblock_start) {
+			r = ext4_blocks_get_direct(file->mp->fs.bdev, u8_buf,
+						   fblock_start, fblock_count);
+			if (r != EOK)
+				goto Finish;
+		} else {
+			memset(u8_buf, 0, run_bytes);
+		}
 
-		size -= block_size * fblock_count;
-		u8_buf += block_size * fblock_count;
-		file->fpos += block_size * fblock_count;
+		size -= run_bytes;
+		u8_buf += run_bytes;
+		file->fpos += run_bytes;
 
 		if (rcnt)
-			*rcnt += block_size * fblock_count;
-
-		fblock_start = fblock;
-		fblock_count = 1;
+			*rcnt += run_bytes;
 	}
 
 	if (size) {
-		uint64_t off;
 		r = ext4_fs_get_inode_dblk_idx(&ref, iblock_idx, &fblock, true);
 		if (r != EOK)
 			goto Finish;
 
-		off = fblock * block_size;
-		r = ext4_block_readbytes(file->mp->fs.bdev, off, u8_buf, size);
-		if (r != EOK)
-			goto Finish;
+		if (fblock) {
+			uint64_t off = fblock * block_size;
+			r = ext4_block_readbytes(file->mp->fs.bdev, off, u8_buf,
+						 size);
+			if (r != EOK)
+				goto Finish;
+		} else {
+			memset(u8_buf, 0, size);
+		}
 
 		file->fpos += size;
 
@@ -2092,6 +2116,19 @@ static int ext4_trans_put_inode_ref(struct ext4_mountpoint *mp,
 }
 
 
+/* Copies at most the on-disk inode size: with 128-byte inodes the last inode
+ * of a block is shorter than struct ext4_inode. */
+static void ext4_raw_inode_copy(struct ext4_fs *fs, struct ext4_inode *dst,
+				struct ext4_inode_ref *ref)
+{
+	size_t n = ext4_get16(&fs->sb, inode_size);
+
+	if (n > sizeof(struct ext4_inode))
+		n = sizeof(struct ext4_inode);
+	memset(dst, 0, sizeof(struct ext4_inode));
+	memcpy(dst, ref->inode, n);
+}
+
 int ext4_raw_inode_fill(const char *path, uint32_t *ret_ino,
 			struct ext4_inode *inode)
 {
@@ -2121,13 +2158,38 @@ int ext4_raw_inode_fill(const char *path, uint32_t *ret_ino,
 	if (ret_ino)
 		*ret_ino = f.inode;
 
-	memcpy(inode, inode_ref.inode, sizeof(struct ext4_inode));
+	ext4_raw_inode_copy(&mp->fs, inode, &inode_ref);
 	ext4_fs_put_inode_ref(&inode_ref);
 	EXT4_MP_UNLOCK(mp);
 
 	return r;
 }
 
+int ext4_raw_inode_fill_ino(const char *mount_point, uint32_t ino,
+			    struct ext4_inode *inode)
+{
+	int r;
+	struct ext4_inode_ref inode_ref;
+	struct ext4_mountpoint *mp = ext4_get_mount(mount_point);
+
+	if (!mp)
+		return ENOENT;
+
+	/* Inode numbers come from the disk: never trust them. */
+	if (ino == 0 || ino > ext4_get32(&mp->fs.sb, inodes_count))
+		return EIO;
+
+	EXT4_MP_LOCK(mp);
+	r = ext4_fs_get_inode_ref(&mp->fs, ino, &inode_ref);
+	if (r == EOK) {
+		ext4_raw_inode_copy(&mp->fs, inode, &inode_ref);
+		r = ext4_fs_put_inode_ref(&inode_ref);
+	}
+	EXT4_MP_UNLOCK(mp);
+
+	return r;
+}
+
 int ext4_inode_exist(const char *path, int type)
 {
 	int r;
@@ -3177,57 +3239,81 @@ int ext4_dir_close(ext4_dir *dir)
     return ext4_fclose(&dir->f);
 }
 
-const ext4_direntry *ext4_dir_entry_next(ext4_dir *dir)
-{
 #define EXT4_DIR_ENTRY_OFFSET_TERM (uint64_t)(-1)
 
-	int r;
+int ext4_dir_entry_get(ext4_dir *dir, const ext4_direntry **out)
+{
+	int r, r2;
 	uint16_t name_length;
-	ext4_direntry *de = 0;
 	struct ext4_inode_ref dir_inode;
 	struct ext4_dir_iter it;
 
+	*out = NULL;
 	EXT4_MP_LOCK(dir->f.mp);
 
 	if (dir->next_off == EXT4_DIR_ENTRY_OFFSET_TERM) {
 		EXT4_MP_UNLOCK(dir->f.mp);
-		return 0;
+		return EOK;
 	}
 
 	r = ext4_fs_get_inode_ref(&dir->f.mp->fs, dir->f.inode, &dir_inode);
-	if (r != EOK) {
+	if (r != EOK)
 		goto Finish;
-	}
 
 	r = ext4_dir_iterator_init(&it, &dir_inode, dir->next_off);
-	if (r != EOK) {
-		ext4_fs_put_inode_ref(&dir_inode);
-		goto Finish;
+	if (r != EOK || !it.curr) {
+		/* End of directory (no current entry) or corrupted block. */
+		dir->next_off = EXT4_DIR_ENTRY_OFFSET_TERM;
+		goto Fini;
+	}
+
+	name_length = ext4_dir_en_get_name_len(&dir->f.mp->fs.sb, it.curr);
+	if (name_length > sizeof(dir->de.name)) {
+		/* rev 0 name_length_high: longer than any valid name. */
+		dir->next_off = EXT4_DIR_ENTRY_OFFSET_TERM;
+		r = EIO;
+		goto Fini;
 	}
 
 	memset(&dir->de.name, 0, sizeof(dir->de.name));
-	name_length = ext4_dir_en_get_name_len(&dir->f.mp->fs.sb,
-					       it.curr);
 	memcpy(&dir->de.name, it.curr->name, name_length);
 
 	/* Directly copying the content isn't safe for Big-endian targets*/
 	dir->de.inode = ext4_dir_en_get_inode(it.curr);
 	dir->de.entry_length = ext4_dir_en_get_entry_len(it.curr);
-	dir->de.name_length = name_length;
+	dir->de.name_length = (uint8_t)name_length;
 	dir->de.inode_type = ext4_dir_en_get_inode_type(&dir->f.mp->fs.sb,
 						      it.curr);
 
-	de = &dir->de;
-
-	ext4_dir_iterator_next(&it);
+	r = ext4_dir_iterator_next(&it);
+	if (r != EOK) {
+		dir->next_off = EXT4_DIR_ENTRY_OFFSET_TERM;
+		goto Fini;
+	}
 
 	dir->next_off = it.curr ? it.curr_off : EXT4_DIR_ENTRY_OFFSET_TERM;
+	*out = &dir->de;
 
-	ext4_dir_iterator_fini(&it);
-	ext4_fs_put_inode_ref(&dir_inode);
-
+Fini:
+	r2 = ext4_dir_iterator_fini(&it);
+	if (r == EOK)
+		r = r2;
+	r2 = ext4_fs_put_inode_ref(&dir_inode);
+	if (r == EOK)
+		r = r2;
+	if (r != EOK)
+		*out = NULL;
 Finish:
 	EXT4_MP_UNLOCK(dir->f.mp);
+	return r;
+}
+
+const ext4_direntry *ext4_dir_entry_next(ext4_dir *dir)
+{
+	const ext4_direntry *de;
+
+	if (ext4_dir_entry_get(dir, &de) != EOK)
+		return NULL;
 	return de;
 }
 
-- 
