+/**@brief   Creation rules and clock (all mount points).*/
+struct ext4_policy {
+	/**@brief   Current time (seconds since the epoch), for timestamps.*/
+	int64_t (*now)(void);
+	/**@brief   Permission bits of a created regular file (e.g. 0644).*/
+	uint16_t file_mode;
+	/**@brief   Permission bits of a created directory (e.g. 0755); the
+	 *          setgid bit of the parent is added.*/
+	uint16_t dir_mode;
+};
+
+/**@brief   Set the creation rules and clock. With a policy, lwext4 keeps
+ *          timestamps like the kernel does (creation: atime, mtime, ctime and
+ *          crtime; write and truncate: mtime and ctime of the file; link,
+ *          unlink and rename: mtime and ctime of the parent directories,
+ *          ctime of the moved or unlinked i-node; dtime of a freed i-node),
+ *          and a created i-node takes the uid and gid of its parent
+ *          directory and the policy mode. NULL (default): upstream behaviour
+ *          (times at 0, uid and gid 0, modes 0666 and 0777).
+ *
+ * @param   p Policy (copied), or NULL.*/
+void ext4_set_policy(const struct ext4_policy *p);
