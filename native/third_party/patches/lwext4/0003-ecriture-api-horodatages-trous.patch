+/**@brief   Creation rules and clock (@ref ext4_set_policy); NULL: upstream
+ *          behaviour.*/
+static struct ext4_policy s_policy;
+static bool s_policy_set;
+
+void ext4_set_policy(const struct ext4_policy *p)
+{
+	s_policy_set = p && p->now;
+	if (s_policy_set)
+		s_policy = *p;
+}
+
+/**@brief   Set time fields of an i-node to the policy clock (no-op without
+ *          policy) and mark it dirty.*/
+static void ext4_touch(struct ext4_inode_ref *ref, uint32_t which)
+{
+	if (!s_policy_set)
+		return;
+	ext4_inode_set_times(&ref->fs->sb, ref->inode, which, s_policy.now());
+	ref->dirty = true;
+}
+
+/**@brief   Deletion time of a freed i-node: the policy clock, or -1 as
+ *          upstream did.*/
+static uint32_t ext4_del_time(void)
+{
+	return s_policy_set ? (uint32_t)s_policy.now() : (uint32_t)-1L;
+}
+
+/**@brief   Attributes of a new i-node from its parent directory (policy
+ *          only): uid and gid of the parent, policy mode (a directory also
+ *          inherits the setgid bit), all four times set to now.*/
+static void ext4_inherit(struct ext4_inode_ref *parent,
+			 struct ext4_inode_ref *child)
+{
+	struct ext4_sblock *sb = &child->fs->sb;
+	struct ext4_inode *p = parent->inode, *c = child->inode;
+	uint32_t type, mode;
+
+	if (!s_policy_set)
+		return;
+
+	type = ext4_inode_type(sb, c);
+	mode = ext4_inode_get_mode(sb, c) & 0xFFF;
+	if (type == EXT4_INODE_MODE_DIRECTORY)
+		mode = (s_policy.dir_mode & 0xFFF) |
+		       (ext4_inode_get_mode(sb, p) & EXT4_INODE_MODE_SGID);
+	else if (type == EXT4_INODE_MODE_FILE)
+		mode = s_policy.file_mode & 0xFFF;
+	ext4_inode_set_mode(sb, c, type | mode);
+
+	/* uid/gid with their high 16 bits (osd2.linux2) */
+	c->uid = p->uid;
+	c->gid = p->gid;
+	c->osd2.linux2.uid_high = p->osd2.linux2.uid_high;
+	c->osd2.linux2.gid_high = p->osd2.linux2.gid_high;
+
+	ext4_touch(child, EXT4_INODE_ATIME | EXT4_INODE_CTIME |
+			  EXT4_INODE_MTIME | EXT4_INODE_CRTIME);
+}
