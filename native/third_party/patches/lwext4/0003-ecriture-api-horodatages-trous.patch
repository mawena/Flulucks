+void ext4_inode_set_times(struct ext4_sblock *sb, struct ext4_inode *inode,
+			  uint32_t which, int64_t t)
+{
+	/* Like the kernel (ext4_encode_extra_time): the base field holds the
+	 * low 32 bits, read back as signed; the 2 epoch bits of the "extra"
+	 * field extend it beyond 2038. Nanoseconds are left at 0. */
+	uint32_t lo = (uint32_t)t;
+	uint32_t epoch = (uint32_t)(((t - (int32_t)lo) >> 32) & 3);
+	uint16_t extra = ext4_inode_get_extra_isize(sb, inode);
+
+	if (which & EXT4_INODE_ATIME) {
+		inode->access_time = to_le32(lo);
+		if (extra >= 16)
+			inode->atime_extra = to_le32(epoch);
+	}
+	if (which & EXT4_INODE_CTIME) {
+		inode->change_inode_time = to_le32(lo);
+		if (extra >= 8)
+			inode->ctime_extra = to_le32(epoch);
+	}
+	if (which & EXT4_INODE_MTIME) {
+		inode->modification_time = to_le32(lo);
+		if (extra >= 12)
+			inode->mtime_extra = to_le32(epoch);
+	}
+	if ((which & EXT4_INODE_CRTIME) && extra >= 24) {
+		inode->crtime = to_le32(lo);
+		inode->crtime_extra = to_le32(epoch);
+	}
