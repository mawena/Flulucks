diff --git a/src/ext4.c b/src/ext4.c
index 2d9e8f7..5eb6633 100644
--- a/src/ext4.c
+++ b/src/ext4.c
@@ -466,12 +466,22 @@ int ext4_mount(const char *dev_name, const char *mount_point,
 	if (r != EOK)
 		return r;
 
+	bd->written_bytes = 0;
 	r = ext4_fs_init(&mp->fs, bd, read_only);
 	if (r != EOK) {
 		ext4_block_fini(bd);
 		return r;
 	}
 
+	/* s_mtime and s_wtime, like the kernel (upstream never set them):
+	 * written with the superblock by ext4_journal_start, and again at
+	 * ext4_umount. */
+	if (!mp->fs.read_only && s_policy_set) {
+		uint32_t now = (uint32_t)s_policy.now();
+		ext4_set32(&mp->fs.sb, mount_time, now);
+		ext4_set32(&mp->fs.sb, write_time, now);
+	}
+
 	bsize = ext4_sb_get_block_size(&mp->fs.sb);
 	ext4_block_set_lb_size(bd, bsize);
 	bc = &mp->bc;
@@ -520,6 +530,15 @@ int ext4_umount(const char *mount_point)
 	 * (disk unplugged or dead): upstream kept the mount point, its cache
 	 * and its pointer to the caller's block device, which could then
 	 * neither be freed nor mounted again. The first error is returned. */
+	/* s_wtime and s_kbytes_written, like the kernel */
+	if (!mp->fs.read_only) {
+		if (s_policy_set)
+			ext4_set32(&mp->fs.sb, write_time,
+				   (uint32_t)s_policy.now());
+		mp->fs.sb.kbytes_written = to_le64(
+			to_le64(mp->fs.sb.kbytes_written) +
+			mp->fs.bdev->written_bytes / 1024);
+	}
 	r = ext4_fs_fini(&mp->fs);
 
 	mp->mounted = 0;
