<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Démarrage (mode clair) : terracotta plein et avant-plan blanc de l'icône, jusqu'au premier rendu Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Fenêtre derrière l'interface Flutter : même couleur que la surface du thème. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/portail_fond</item>
    </style>
    <!-- Lecteur vidéo : noir plein écran, barres système comprises ; aucun éclair clair à l'ouverture. -->
    <style name="VideoTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
