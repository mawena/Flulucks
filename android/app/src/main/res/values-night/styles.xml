<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Démarrage (mode sombre) : terracotta plein et avant-plan blanc de l'icône, jusqu'au premier rendu Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Fenêtre derrière l'interface Flutter : même couleur que la surface du thème. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/portail_fond</item>
    </style>
</resources>
